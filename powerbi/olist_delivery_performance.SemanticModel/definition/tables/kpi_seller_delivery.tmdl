table kpi_seller_delivery
	lineageTag: 94e45e7e-0a4c-44c4-8328-bb8024dbd956

	measure Sellers = COUNTROWS(kpi_seller_delivery)
		formatString: #,0
		lineageTag: 1d0de282-3409-4058-818e-e7127a138b64

	measure 'Sellers Behind Half Of Late Orders' = CALCULATE(COUNTROWS(kpi_seller_delivery), kpi_seller_delivery[cum_pct_of_late_orders] <= 50)
