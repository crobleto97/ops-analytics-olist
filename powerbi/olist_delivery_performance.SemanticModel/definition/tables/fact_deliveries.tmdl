table fact_deliveries
	lineageTag: dd224714-de4a-4b2a-8300-2e5591cd598b

	measure Orders = COUNTROWS(fact_deliveries)
		formatString: #,0
		lineageTag: fe786c23-f13d-4ce0-a4d6-ba9d27fb8032

	measure 'Delivered Orders' = CALCULATE([Orders], fact_deliveries[is_delivered] = TRUE())
		formatString: #,0
		lineageTag: f4fb5d4c-c794-49c9-b7bf-e0a4071cbcb7

	measure 'Late Orders' = CALCULATE([Orders], fact_deliveries[is_late] = TRUE())
		formatString: #,0
		lineageTag: 10361817-ebd3-41b9-a6ee-8a4e91234c59

	measure '% Late' = DIVIDE([Late Orders], [Delivered Orders])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: db0e2c6a-495b-42fe-a4c7-1787b98f1210

	measure Revenue =
			
			CALCULATE(
			    SUM(fact_deliveries[items_value]),
			    NOT fact_deliveries[order_status] IN { "canceled", "unavailable" }
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 3414099c-3fe6-44f7-80e6-33f560d5d186

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Avg Review' = AVERAGE(fact_deliveries[review_score])
		formatString: 0.00
		lineageTag: fcb3ee2c-40da-465c-801c-abee5f385e2d

	measure 'Avg Delivery Days' = AVERAGE(fact_deliveries[days_total])
		formatString: 0.0" days"
		lineageTag: 51eb3ba1-200b-4545-b7e9-63214360a4cf

	measure 'Avg Days Late' = CALCULATE(AVERAGE(fact_deliveries[days_late]), fact_deliveries[is_late] = TRUE())
		formatString: 0.0" days"
		lineageTag: 3f0824ef-70c8-4c94-85e0-3bae100faf50

	measure 'Avg Days To Approve' = AVERAGE(fact_deliveries[days_to_approve])
		formatString: 0.0
		lineageTag: 2e7497ec-f66a-409c-9abb-3f0a95862d27

	measure 'Avg Days Seller To Carrier' = AVERAGE(fact_deliveries[days_seller_to_carrier])
		formatString: 0.0
		lineageTag: 46125395-092b-4c04-8b08-4b956b7e06ea

	measure 'Avg Days Carrier To Customer' = AVERAGE(fact_deliveries[days_carrier_to_customer])
		formatString: 0.0
		lineageTag: feabcc8a-f35f-4fb3-8afa-07c245a3b864

	measure Customers = DISTINCTCOUNT(fact_deliveries[customer_key])
		formatString: #,0
		lineageTag: da16f790-c5ed-4a3e-a22c-c8c27e9fcc7c

	measure 'Repeat Customer %' = VAR c = ADDCOLUMNS(VALUES(fact_deliveries[customer_key]), "@orders", CALCULATE(COUNTROWS(fact_deliveries))) RETURN DIVIDE(COUNTROWS(FILTER(c, [@orders] > 1)), COUNTROWS(c))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 46cd8acd-bcf8-493e-ac39-eda7f2fd16b4

