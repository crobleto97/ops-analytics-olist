			    TRUE(),
			    fact_deliveries[is_late] = TRUE(), "Late",
			    fact_deliveries[is_delivered] = TRUE(), "On time",
			    "Not delivered"
			)
		dataType: string
		lineageTag: aa7da2dd-b678-4691-b4a4-d8dde16bb32f
